              ],
              "path": [
                "api",
                "watches"
              ]
            }
          }
        },
        {
          "name": "05.2 Verify LIFO Compensation Order in Saga Logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var saga = pm.response.json().data;",
                  "var compensations = saga.steps.filter(function(s) { return s.phase === 'COMPENSATE'; });",
                  "pm.test('Compensations executed in reverse LIFO order: UNASSIGN_BRAND before DELETE_WATCH', function () {",
                  "  pm.expect(compensations[0].stepName).to.eql('UNASSIGN_BRAND');",
                  "  pm.expect(compensations[1].stepName).to.eql('DELETE_WATCH');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sagas/{{lifoSagaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sagas",
                "{{lifoSagaId}}"
              ]
            }
          }
        }
      ]
    },
