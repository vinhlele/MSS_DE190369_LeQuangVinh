      "item": [
        {
          "name": "05.1 Create Watch with X-Saga-Fail-After-Step: 2 -> 500 & COMPENSATED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 500 Internal Server Error', function () { pm.response.to.have.status(500); });",
                  "var json = pm.response.json();",
                  "pm.test('Saga status is COMPENSATED', function () {",
                  "  pm.expect(json.data.sagaStatus).to.eql('COMPENSATED');",
                  "  pm.collectionVariables.set('lifoSagaId', json.data.sagaId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Saga-Fail-After-Step",
                "value": "2"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Fault Injection Simulation Watch\",\"categoryId\":3,\"brandId\":2,\"caseMaterial\":\"Gold\",\"strapMaterial\":\"Leather\",\"waterpMaterial\":\"30 meters\",\"price\":1500,\"releaseDate\":\"2026-11-06\",\"stock\":20}"
            },
