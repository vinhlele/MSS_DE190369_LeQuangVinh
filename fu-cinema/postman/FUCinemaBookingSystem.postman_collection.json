      "name": "01. Authentication & Profile",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phoneNumber\": \"0987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.test(\"Registration returns valid customer profile\", function () {",
                  "        pm.expect(data).to.have.property(\"id\");",
                  "        pm.expect(data.email).to.eql(pm.environment.get(\"customerEmail\"));",
                  "    });",
                  "    pm.environment.set(\"customerId\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
