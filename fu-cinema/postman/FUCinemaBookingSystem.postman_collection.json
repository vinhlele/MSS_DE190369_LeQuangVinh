                  "    pm.expect(data.user.role).to.eql(\"CUSTOMER\");",
                  "});",
                  "pm.environment.set(\"customerToken\", data.token);",
                  "pm.environment.set(\"token\", data.token);",
                  "if (data.user && data.user.id) {",
                  "    pm.environment.set(\"customerId\", data.user.id);",
